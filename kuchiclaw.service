[Unit]
Description=KuchiClaw AI Agent
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
# The in-process circuit breaker (src/circuit-breaker.ts) is the PRIMARY control:
# it backs off crash-loops (so the unit self-heals through a longer transient
# outage instead of being permanently failed at 5 quick crashes) and fires the
# alert on a sustained loop. StartLimit here is only a LOOSE FAILSAFE: the
# breaker's escalating backoff never spaces starts fast enough to reach 20 in
# 300s, so normal operation never trips it — but a breaker that can't run (fast
# restarts with no backoff) hits ~60 starts/300s and trips it, so OnFailure still
# alerts. This avoids the silent-8-day-crash-loop without making the breaker
# precisely shadow a tight systemd window (which it structurally cannot).
OnFailure=kuchiclaw-alert@%n.service
StartLimitBurst=20
StartLimitIntervalSec=300

[Service]
Type=simple
User=kuchiclaw
Group=kuchiclaw
WorkingDirectory=/opt/kuchiclaw
EnvironmentFile=/opt/kuchiclaw/.env
ExecStart=/usr/bin/npx tsx src/index.ts
Restart=always
RestartSec=5

# Graceful shutdown — SIGTERM triggers the handler in index.ts
KillSignal=SIGTERM
TimeoutStopSec=90

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
ReadWritePaths=/opt/kuchiclaw/data /opt/kuchiclaw/groups
ProtectHome=yes

# Logging via journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kuchiclaw

[Install]
WantedBy=multi-user.target
