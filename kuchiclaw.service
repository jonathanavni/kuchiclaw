[Unit]
Description=KuchiClaw AI Agent
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
# Persistent-crash-loop alerting is now owned by the in-process circuit breaker
# (src/circuit-breaker.ts): it backs off so a transient loop rides out without
# tripping StartLimit, and it fires the same alert script on a sustained loop.
# StartLimit stays as a FAILSAFE — if the breaker itself can't run (so restarts
# come with no backoff), these limits still trip and OnFailure still alerts,
# preventing the silent-8-day-crash-loop that motivated them originally.
OnFailure=kuchiclaw-alert@%n.service
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=simple
User=kuchiclaw
Group=kuchiclaw
WorkingDirectory=/opt/kuchiclaw
EnvironmentFile=/opt/kuchiclaw/.env
ExecStart=/usr/bin/npx tsx src/index.ts
Restart=always
RestartSec=5

# Graceful shutdown — SIGTERM triggers the handler in index.ts
KillSignal=SIGTERM
TimeoutStopSec=90

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
ReadWritePaths=/opt/kuchiclaw/data /opt/kuchiclaw/groups
ProtectHome=yes

# Logging via journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kuchiclaw

[Install]
WantedBy=multi-user.target
